# Sanity CMS Configuration
NEXT_PUBLIC_SANITY_PROJECT_ID="your_sanity_project_id"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2026-03-01"

# Sanity API Write Token (Optional: for migration/seed scripts)
SANITY_API_WRITE_TOKEN="your_sanity_api_token"

# On-Demand Webhook Revalidation Secret (Matches the secret in sanity.io/manage -> API -> Webhooks)
SANITY_REVALIDATE_SECRET="your_secure_random_revalidation_secret"
